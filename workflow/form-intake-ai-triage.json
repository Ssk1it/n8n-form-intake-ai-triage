          "__rl": true,
          "value": "#alerts",
          "mode": "name"
        },
        "text": "=Submission rejected - missing required fields: {{ $json.missing.join(', ') }}",
        "otherOptions": {}
      },
      "id": "aa000009-1111-4111-8111-000000000009",
